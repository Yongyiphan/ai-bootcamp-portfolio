pipeline {
    agent any
    stages {
        stage('Prepare') {
            steps {
                dir('/workspace') {
                    sh 'python3 -m venv .ci-venv'
                    sh '.ci-venv/bin/pip install -r requirements.txt'
                }
            }
        }
        stage('Verify') {
            steps {
                dir('/workspace') {
                    sh '.ci-venv/bin/python -m pytest -q --junitxml=test-results.xml'
                }
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'test-results.xml'
        }
    }
}
